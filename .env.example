# Copy this file to .env and uncomment what you need. Every value here is
# optional: with no .env at all, the game talks to LM Studio on its default
# port and auto-detects the loaded model. .env is gitignored; this template
# is committed so the available settings stay documented in one place.

# --- Local model server (LM Studio, llama.cpp, or any OpenAI-compatible API) ---
# Where the chat model is served. LM Studio's default is shown.
#LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# API key. LM Studio ignores the value but the client still sends one.
#LOCAL_LLM_API_KEY=lm-studio
# Force a specific model id. Leave unset to auto-detect whichever model is
# actually resident in the server (see detect_loaded_model in main.py).
#LOCAL_LLM_MODEL=google/gemma-4-12b-qat
# Embedding model used to index the lore + SRD for retrieval. Must be loaded in
# the server alongside the chat model. Defaults to the nomic embedder shown.
#LOCAL_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# --- Data location ---
# The engine finds the campaign/lore/SRD corpus by walking up from the package
# to the folder that holds knowledge/. Set this only if you keep that data
# somewhere non-standard; point it at the folder that contains knowledge/.
#TTRPG_CREW_ROOT=/path/to/ttrpg_crew

# --- Prompt tier ---
# large | medium | small. Controls how dense the prompts are. Leave unset to
# pick automatically from the model's parameter count (see models.yaml).
#TTRPG_CREW_MODEL_TIER=medium

# --- Moderator (speaker selection) ---
# Speaker selection is deterministic by default (fast, no per-beat LLM call).
# Set this to 1 to use the LLM manager agent instead (richer, slower, less
# consistent on small models).
#TTRPG_LLM_MODERATOR=1
# Only used when TTRPG_LLM_MODERATOR=1: route the moderator to a faster model
# so the speaker pick does not tie up the big narration model.
#LOCAL_MANAGER_MODEL=qwen2.5-1.5b-instruct

# --- Editor (AI-ism rewrite pass) ---
# The editor only runs when the auditor flags GM/companion output, so a small,
# fast model is ideal. CAUTION: on a single GPU with one server, naming a
# different model than the GM forces a swap (unload GM, load editor, swap back)
# every time it fires, which is slower overall. Use this only when the editor
# model can stay resident: either a SEPARATE endpoint (LOCAL_EDITOR_BASE_URL
# below, e.g. a second server or a CPU-hosted small model), or enough VRAM to
# hold both models at once. Unset = reuse the main GM model for edits.
#LOCAL_EDITOR_MODEL=qwen2.5-1.5b-instruct
# Separate server for the editor model. Defaults to LOCAL_LLM_BASE_URL.
#LOCAL_EDITOR_BASE_URL=http://localhost:5678/v1
# API key for the editor server. Defaults to LOCAL_LLM_API_KEY.
#LOCAL_EDITOR_API_KEY=lm-studio

# --- Companion generation path ---
# Companions run through the CrewAI agent loop by DEFAULT (richer in-scene
# interplay in play-testing). Set to 1 for direct chat completions instead:
# no ReAct preamble, much fewer tokens, faster — at some cost in interplay.
# The GM runs through CrewAI either way.
#TTRPG_DIRECT_COMPANIONS=1

# --- Diagnostics ---
# Show engine internals during play: agent panels, [timing] and [audit] lines.
# Leave unset for clean narration-only output.
#TTRPG_DEBUG=1
